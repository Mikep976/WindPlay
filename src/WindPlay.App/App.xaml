<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WindPlay.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="CardFillColor">#D9FFFFFF</Color>
                    <Color x:Key="HeroTopColor">#FFF4FAFF</Color>
                    <Color x:Key="HeroBottomColor">#FFE4F1FF</Color>
                    <Color x:Key="SubtleStrokeColor">#18000000</Color>
                    <Color x:Key="SecondaryTextColor">#99000000</Color>
                    <Color x:Key="ScreenFillColor">#FFF7FBFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="CardFillColor">#B31E1E22</Color>
                    <Color x:Key="HeroTopColor">#FF222A33</Color>
                    <Color x:Key="HeroBottomColor">#FF14171C</Color>
                    <Color x:Key="SubtleStrokeColor">#28FFFFFF</Color>
                    <Color x:Key="SecondaryTextColor">#A8FFFFFF</Color>
                    <Color x:Key="ScreenFillColor">#FF101216</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="CardFillColor">{ThemeResource SystemColorWindowColor}</Color>
                    <Color x:Key="HeroTopColor">{ThemeResource SystemColorWindowColor}</Color>
                    <Color x:Key="HeroBottomColor">{ThemeResource SystemColorWindowColor}</Color>
                    <Color x:Key="SubtleStrokeColor">{ThemeResource SystemColorWindowTextColor}</Color>
                    <Color x:Key="SecondaryTextColor">{ThemeResource SystemColorWindowTextColor}</Color>
                    <Color x:Key="ScreenFillColor">{ThemeResource SystemColorWindowColor}</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="CardFillBrush" Color="{ThemeResource CardFillColor}" />
            <SolidColorBrush x:Key="SubtleStrokeBrush" Color="{ThemeResource SubtleStrokeColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="ScreenFillBrush" Color="{ThemeResource ScreenFillColor}" />

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardFillBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="TouchButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
