<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindPlay.App.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border
                    Width="28"
                    Height="28"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="7">
                    <FontIcon FontSize="14" Foreground="White" Glyph="&#xE714;" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="WindPlay" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" IsSelected="True" Tag="home">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Privacy" Tag="privacy">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <InfoBar
                    x:Name="ErrorBar"
                    Margin="24,12,24,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="Receiver unavailable" />

                <ScrollViewer x:Name="HomeView" Padding="24,20,24,32">
                    <StackPanel MaxWidth="1100" Spacing="16">
                        <Border Padding="28" CornerRadius="20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="{ThemeResource HeroTopColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource HeroBottomColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnSpacing="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel MaxWidth="620" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock x:Name="StatusText" Style="{ThemeResource CaptionTextBlockStyle}" Text="Starting…" />
                                    </StackPanel>
                                    <TextBlock
                                        FontFamily="Segoe UI Variable Display"
                                        FontSize="34"
                                        FontWeight="SemiBold"
                                        Text="Your Surface is a display now."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource SecondaryTextBrush}"
                                        FontSize="16"
                                        Text="Extend your Mac desktop or mirror an iPhone here—with native ARM64 playback and no cloud relay."
                                        TextWrapping="Wrap" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
                                        <ToggleSwitch
                                            x:Name="ReceiverToggle"
                                            Header="Accept AirPlay connections"
                                            IsOn="False"
                                            Toggled="ReceiverToggle_Toggled" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Column="1" Width="220" Height="150">
                                    <Border
                                        Margin="8,4,8,28"
                                        Background="#1A000000"
                                        CornerRadius="20"
                                        Translation="0,10,0" />
                                    <Border
                                        Margin="8,0,8,32"
                                        Padding="10"
                                        Background="{ThemeResource CardFillBrush}"
                                        BorderBrush="#55FFFFFF"
                                        BorderThickness="2"
                                        CornerRadius="20">
                                        <Border Background="{ThemeResource ScreenFillBrush}" CornerRadius="11">
                                            <Grid>
                                                <Ellipse Width="72" Height="72" Fill="{ThemeResource AccentFillColorSecondaryBrush}" Opacity="0.35" />
                                                <FontIcon FontSize="46" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE714;" />
                                            </Grid>
                                        </Border>
                                    </Border>
                                    <Path
                                        Width="66"
                                        Height="46"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Data="M 33,0 L 66,46 L 0,46 Z"
                                        Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Connect from your Mac" />
                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Width="32" Height="32" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="16"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" /></Border>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Open Control Center → Screen Mirroring." TextWrapping="Wrap" />
                                        <Border Grid.Row="1" Width="32" Height="32" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="16"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="2" /></Border>
                                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="Choose the receiver name shown below." TextWrapping="Wrap" />
                                        <Border Grid.Row="2" Width="32" Height="32" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="16"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="3" /></Border>
                                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="In Displays, select “Use as Separate Display.”" TextWrapping="Wrap" />
                                    </Grid>
                                    <Border Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="RECEIVER" />
                                                <TextBlock x:Name="ReceiverNameText" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="WindPlay" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Padding="10,6" Click="CopyNameButton_Click" Content="Copy" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Private connection" />
                                    <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" Text="Enter this passcode when your Apple device asks. It stays encrypted for your Windows account." TextWrapping="Wrap" />
                                    <Border Padding="16" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="PasscodeText"
                                                FontFamily="Cascadia Mono"
                                                FontSize="30"
                                                FontWeight="SemiBold"
                                                CharacterSpacing="180"
                                                Text="••••" />
                                            <Button Grid.Column="1" Style="{StaticResource TouchButtonStyle}" Click="CopyPasscodeButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" /><TextBlock Text="Copy" /></StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                        <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" Text="Local network only • no recording • no telemetry" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12">
                                    <FontIcon x:Name="SessionIcon" FontSize="22" Glyph="&#xE7F4;" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="SessionTitleText" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Waiting for a device" />
                                    <TextBlock x:Name="SessionDetailText" Foreground="{ThemeResource SecondaryTextBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="Keep this app open, then connect from Control Center." />
                                </StackPanel>
                                <ProgressRing x:Name="SessionProgress" Grid.Column="3" Width="24" Height="24" IsActive="False" />
                                <Button x:Name="DisconnectSessionButton" Grid.Column="3" Visibility="Collapsed" Click="DisconnectSessionButton_Click" Content="Disconnect" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsView" Padding="24,20,24,32" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" Spacing="16">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Settings" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="18">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Receiver" />
                                <TextBox x:Name="ReceiverNameBox" Header="Name visible on Apple devices" MaxLength="64" />
                                <ToggleSwitch x:Name="RequirePasscodeToggle" Header="Require passcode" OffContent="Anyone on this LAN can connect" OnContent="Recommended" />
                                <ToggleSwitch x:Name="StartOnLaunchToggle" Header="Start receiving when WindPlay opens" />
                                <ToggleSwitch x:Name="FullScreenToggle" Header="Open streams full screen" />
                                <ToggleSwitch x:Name="KeepAwakeToggle" Header="Keep the display awake while streaming" />
                                <NumberBox x:Name="MaximumConnectionsBox" Header="Maximum simultaneous connection attempts" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="SaveSettingsButton" Style="{StaticResource TouchButtonStyle}" HorizontalAlignment="Left" Click="SaveSettingsButton_Click" Content="Save and apply" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PrivacyView" Padding="24,20,24,32" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" Spacing="16">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Privacy &amp; security" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Safe by default" />
                                <TextBlock Text="WindPlay talks directly to devices on your LAN. It has no account, cloud relay, analytics SDK, crash uploader, recording, or screenshot history." TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="PublicNetworksToggle" Header="Allow routed or public IP addresses" OffContent="Private and link-local ranges only" OnContent="Use only on a trusted network" />
                                <ToggleSwitch x:Name="DiagnosticsToggle" Header="Write local diagnostic logs" OffContent="No logs are written" OnContent="Rotated locally after 7 days" />
                                <ToggleSwitch x:Name="PerformanceOverlayToggle" Header="Show frame statistics while streaming" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Style="{StaticResource TouchButtonStyle}" Click="OpenFirewallButton_Click" Content="Windows Firewall" />
                                    <Button Style="{StaticResource TouchButtonStyle}" Click="OpenLogsButton_Click" Content="Open logs" />
                                </StackPanel>
                                <Button Style="{StaticResource TouchButtonStyle}" HorizontalAlignment="Left" Click="SaveSettingsButton_Click" Content="Save and apply" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AboutView" Padding="24,20,24,32" Visibility="Collapsed">
                    <StackPanel MaxWidth="700" Spacing="16">
                        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="About WindPlay" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Text="WindPlay" />
                                <TextBlock x:Name="VersionText" Foreground="{ThemeResource SecondaryTextBrush}" />
                                <TextBlock Text="An independent, open-source AirPlay receiver built for Windows 11 on ARM. Protected FairPlay/DRM playback is intentionally not supported." TextWrapping="Wrap" />
                                <HyperlinkButton NavigateUri="https://github.com/Mikep976/WindPlay" Content="View source on GitHub" />
                                <TextBlock Foreground="{ThemeResource SecondaryTextBrush}" Text="AirPlay and Apple are trademarks of Apple Inc. WindPlay is not affiliated with or endorsed by Apple." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
